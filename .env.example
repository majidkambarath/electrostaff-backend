PORT=5000
# Atlas: URL-encode special characters in password (@ # : / etc.)
# MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/fayas?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=mongodb://127.0.0.1:27017/electrostaff
# Public "Create your business" sign-up (true by default). false = only the platform portal creates businesses.
SIGNUP_ENABLED=true

# --- Security (all optional in development) ---
# Signing key for sign-in tokens. If empty, one is generated and kept in backend/.secrets.json.
# Set it explicitly in production (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`).
JWT_SECRET=
# How long a sign-in lasts (jsonwebtoken format: 30d, 12h, ...).
TOKEN_TTL=30d
# Comma-separated browser origins allowed to call the API. Empty = any origin (dev / LAN testing).
# CORS_ORIGINS=https://staff.example.com
CORS_ORIGINS=
# Express "trust proxy": loopback (default), a hop count like 1 behind one reverse proxy, or true.
TRUST_PROXY=
# Requests per minute per IP for /api, and sign-in attempts per 15 minutes per IP.
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT=50

# --- Web Push (phone notifications) ---
# If empty, a key pair is generated and kept in backend/.secrets.json.
# Generate your own with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
